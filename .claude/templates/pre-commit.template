#!/usr/bin/env python3
# pre-commit — stamp Version/Created/Updated into staged Python file headers
# Author: Pito Salas and Claude Code
# Open Source Under MIT license
"""Git pre-commit hook enforcing the file-header rule in .claude/style_guide.md.

For every staged .py file it rewrites three header lines and re-stages the file:

  Version  incremented by one (1 if the file has no Version line yet)
  Created  written once, on the first commit that stamps the file; never rewritten
  Updated  set to today

Version is carried from the file rather than derived from `git rev-list --count`
so the count survives renames, which `--count` does not follow. Created is
likewise preserved from the file, so a moved file keeps its original date.

Files are searched for the header only in the first HEADER_SCAN_LINES lines. A
file with no Author line is skipped with a warning rather than guessed at.
"""
import datetime
import re
import subprocess
import sys

HEADER_SCAN_LINES = 12
AUTHOR_RE = re.compile(r"^#\s*Author:", re.IGNORECASE)
FIELD_RES = {
    "Version": re.compile(r"^#\s*Version:\s*(\d+)\s*$", re.IGNORECASE),
    "Created": re.compile(r"^#\s*Created:\s*(\S+)\s*$", re.IGNORECASE),
    "Updated": re.compile(r"^#\s*Updated:\s*(\S+)\s*$", re.IGNORECASE),
}


def staged_python_files() -> list[str]:
    """Return staged paths that still exist (added, copied, modified, renamed)."""
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
        capture_output=True, text=True, check=True,
    ).stdout
    return [line for line in out.splitlines() if line.endswith(".py")]


def find_field(lines: list[str], name: str) -> tuple[int, str] | None:
    """Return (index, captured value) for a header field, or None if absent."""
    for i, line in enumerate(lines[:HEADER_SCAN_LINES]):
        match = FIELD_RES[name].match(line)
        if match:
            return i, match.group(1)
    return None


def find_author_index(lines: list[str]) -> int | None:
    for i, line in enumerate(lines[:HEADER_SCAN_LINES]):
        if AUTHOR_RE.match(line):
            return i
    return None


def stamp(path: str, today: str) -> bool:
    """Rewrite path's header fields. Return True if the file changed on disk."""
    with open(path, encoding="utf-8") as handle:
        original = handle.read()
    lines = original.split("\n")

    author_index = find_author_index(lines)
    if author_index is None:
        print(f"pre-commit: {path} has no 'Author:' header line, skipping",
              file=sys.stderr)
        return False

    version_field = find_field(lines, "Version")
    created_field = find_field(lines, "Created")
    updated_field = find_field(lines, "Updated")

    next_version = int(version_field[1]) + 1 if version_field else 1
    created = created_field[1] if created_field else today

    # Rewrite in place where the field exists; otherwise insert the whole block
    # directly below Author so field order matches the style guide.
    if version_field:
        lines[version_field[0]] = f"# Version: {next_version}"
    if created_field:
        lines[created_field[0]] = f"# Created: {created}"
    if updated_field:
        lines[updated_field[0]] = f"# Updated: {today}"

    inserts = []
    if version_field is None:
        inserts.append(f"# Version: {next_version}")
    if created_field is None:
        inserts.append(f"# Created: {created}")
    if updated_field is None:
        inserts.append(f"# Updated: {today}")
    lines[author_index + 1:author_index + 1] = inserts

    stamped = "\n".join(lines)
    if stamped == original:
        return False
    with open(path, "w", encoding="utf-8") as handle:
        handle.write(stamped)
    return True


def main() -> int:
    today = datetime.date.today().isoformat()
    restaged = []
    for path in staged_python_files():
        try:
            if stamp(path, today):
                restaged.append(path)
        except OSError as exc:
            print(f"pre-commit: cannot stamp {path}: {exc}", file=sys.stderr)
            return 1
    if restaged:
        subprocess.run(["git", "add", "--"] + restaged, check=True)
        print(f"pre-commit: stamped headers in {len(restaged)} file(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
